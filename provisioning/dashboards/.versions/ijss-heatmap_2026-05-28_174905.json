    "panel-2": {
      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "${datasource_picker}"
                    },
                    "group": "grafana-postgresql-datasource",
                    "kind": "DataQuery",
                    "spec": {
                      "editorMode": "code",
                      "format": "table",
                      "rawQuery": true,
                      "rawSql": "SELECT\n  d::date AS time,\n  1 AS value\nFROM std.vw_employees e\nJOIN std.std_bordereaux b ON b.nir = e.nir\nCROSS JOIN LATERAL generate_series(\n  b.start_date,\n  COALESCE(b.end_date, b.start_date),\n  interval '1 day'\n) d\nWHERE e.individual_registration_number = '${matricule}'\n  AND b.start_date IS NOT NULL\nORDER BY time;"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
        "description": "all BPIJ bordereaux by NIR (from employees table)",
        "id": 2,
        "links": [],
        "title": "BPIJ / NIR",
        "vizConfig": {
          "group": "tim012432-calendarheatmap-panel",
          "kind": "VizConfig",
          "spec": {
