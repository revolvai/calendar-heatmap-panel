              "emptyColor": "#00000057",
              "labelField": "",
              "monthLabelCustom": "Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec",
              "monthLabelMode": "default",
              "radius": 1,
              "rectSize": 11,
              "showLegend": false,
              "showMonthLabels": true,
              "showTooltip": true,
              "showWeekLabels": true,
