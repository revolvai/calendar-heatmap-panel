                      "rawQuery": true,
                      "rawSql": "WITH employee AS (\n  SELECT e.*, os.establishment_name AS organization_name\n  FROM std.vw_employees e\n  LEFT JOIN tnt.organization_sirets os ON os.org_id = e.organization_id\n  WHERE e.individual_registration_number = '${matricule}'\n  LIMIT 1\n)\nSELECT 'Organization' AS field, organization_name::text AS value FROM employee\nUNION ALL\nSELECT 'SIRET', siret::text FROM employee\nUNION ALL\nSELECT 'Establishment', establishment_name::text FROM employee\nUNION ALL\nSELECT 'Region', establishment_region::text FROM employee;"
