    "panel-3": {
      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "${datasource_picker}"
                    },
                    "group": "grafana-postgresql-datasource",
                    "kind": "DataQuery",
                    "spec": {
                      "editorMode": "code",
                      "format": "table",
                      "rawQuery": true,
                      "rawSql": "SELECT\n  time,\n  SUM(value) AS value\nFROM (\n  SELECT\n    d::date AS time,\n    COALESCE(NULLIF(b.amount_net, 0), NULLIF(b.amount_brut, 0), 0)\n      / NULLIF((COALESCE(b.end_date, b.start_date) - b.start_date + 1), 0) AS value\n  FROM std.vw_employees e\n  JOIN std.std_leaves l ON l.declaration_id = e.declaration_id::uuid\n  JOIN std.std_bordereaux b ON b.leave_id = l.id AND b.nir = e.nir\n  CROSS JOIN LATERAL generate_series(\n    b.start_date,\n    COALESCE(b.end_date, b.start_date),\n    interval '1 day'\n  ) d\n  WHERE e.individual_registration_number = '${matricule}'\n    AND b.start_date IS NOT NULL\n) x\nGROUP BY time\nORDER BY time;"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
        "description": "reimbursed bordereaux linked through leave_id",
        "id": 3,
        "links": [],
        "title": "REIMBOURSEMENT / MATRICULE",
