    "panel-4": {
      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "${datasource_picker}"
                    },
                    "group": "grafana-postgresql-datasource",
                    "kind": "DataQuery",
                    "spec": {
                      "editorMode": "code",
                      "format": "table",
                      "rawQuery": true,
                      "rawSql": "WITH employee AS (\n  SELECT DISTINCT e.nir, e.individual_registration_number, e.declaration_id::uuid AS declaration_id\n  FROM std.vw_employees e\n  WHERE e.individual_registration_number = '${matricule}'\n),\nabsence_days AS (\n  SELECT DISTINCT d::date AS time\n  FROM employee e\n  JOIN std.std_absences a ON a.individual_registration_number = e.individual_registration_number\n  CROSS JOIN LATERAL generate_series(\n    a.absence_start,\n    COALESCE(a.absence_end, a.absence_start),\n    interval '1 day'\n  ) d\n  WHERE a.absence_start IS NOT NULL\n),\nreimbursed_days AS (\n  SELECT DISTINCT d::date AS time\n  FROM employee e\n  JOIN std.std_leaves l ON l.declaration_id = e.declaration_id\n  JOIN std.std_bordereaux b ON b.leave_id = l.id AND b.nir = e.nir\n  CROSS JOIN LATERAL generate_series(\n    b.start_date,\n    COALESCE(b.end_date, b.start_date),\n    interval '1 day'\n  ) d\n  WHERE b.start_date IS NOT NULL\n)\nSELECT ad.time, 1 AS value\nFROM absence_days ad\nLEFT JOIN reimbursed_days rd ON rd.time = ad.time\nWHERE rd.time IS NULL\nORDER BY ad.time;"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
