                      "rawQuery": true,
                      "rawSql": "WITH employee AS (\n  SELECT e.*\n  FROM std.vw_employees e\n  WHERE e.individual_registration_number = '${matricule}'\n  LIMIT 1\n)\nSELECT 'Employee Name' AS field, CONCAT(first_name, ' ', last_name) AS value FROM employee\nUNION ALL\nSELECT 'Matricule', individual_registration_number::text FROM employee\nUNION ALL\nSELECT 'Gap', gap::text FROM employee;"
